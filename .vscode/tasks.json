{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar (estilo ZinjaI)",
      "type": "shell",
      "command": "g++ -std=c++17 -g $(find src -name '*.cpp') -o Debug_Linux/Proyecto_Datos_Tetris.bin -lsfml-graphics -lsfml-audio -lsfml-network -lsfml-window -lsfml-system",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
